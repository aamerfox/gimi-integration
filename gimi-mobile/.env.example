# ─────────────────────────────────────────────────────────────────────────────
# trace+ Mobile App — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# TrackSolid / Jimi API credentials (obtained from the TrackSolid Open Platform)
EXPO_PUBLIC_APP_KEY=YOUR_APP_KEY_HERE
EXPO_PUBLIC_APP_SECRET=YOUR_APP_SECRET_HERE

# OCI Tag API key (obtained from the OCI Tag portal)
EXPO_PUBLIC_TAG_APP_KEY=YOUR_TAG_APP_KEY_HERE

# HMAC secret for signing share links
EXPO_PUBLIC_SHARE_SECRET=YOUR_SHARE_SECRET_HERE
